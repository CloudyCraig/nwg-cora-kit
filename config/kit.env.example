# ============================================================================
# NWG Cora AI-Agent Demo Kit — configuration
# Copy to kit.env, fill in, then follow SETUP order in README.md.
# NEVER commit kit.env (real tokens) anywhere.
# ============================================================================

# ---- Customisation --------------------------------------------------------
# The assistant's display name (spans, AI Agent Monitoring row, system prompt)
CORA_AGENT_NAME="Cora"
# Stable agent id used in gen_ai.agent.id (change if you rename the agent)
CORA_AGENT_ID="cora-natwest-assistant"
# Bank name woven into the system prompt
CORA_BANK_NAME="NatWest"
# Anthropic model the agent calls (undated alias is fine for the API...)
CORA_MODEL="claude-haiku-4-5"
# ...but the Splunk LLM-provider connection MUST use the exact dated id:
LLM_CONNECTION_MODEL="claude-haiku-4-5-20251001"

# ---- Anthropic -------------------------------------------------------------
# Real key is applied straight into the k8s secret, never into manifests:
#   kubectl -n <ns> create secret generic cora-anthropic \
#     --from-literal=ANTHROPIC_API_KEY=<key>
ANTHROPIC_API_KEY="<set-via-kubectl-only>"

# ---- Splunk Observability Cloud --------------------------------------------
SPLUNK_REALM="eu2"
SPLUNK_ORG_ID="<your-o11y-org-id>"
# INGEST token for cora-otelcol. CRITICAL RECIPE: create it with BOTH
# "INGEST" and "API token with roles" ticked, and add the ai_monitoring
# role — an INGEST-only token can never carry the role and the AI trace
# store silently ignores spans it ingests. (Kit docs, section 'Token'.)
SPLUNK_INGEST_TOKEN="<ingest+api token with ai_monitoring role>"
# API token used by the create-dashboard script
SPLUNK_API_TOKEN="<api token>"

# ---- Splunk Enterprise / ITSI ----------------------------------------------
SPLUNK_ENTERPRISE_HOST="<your-splunk-box>"        # e.g. nwg.crgpov.com
SPLUNK_ENTERPRISE_ADMIN_USER="admin"
SPLUNK_ENTERPRISE_ADMIN_PASSWORD="<password>"
# HEC for the agent's cora_ask audit events (drives the ITSI KPIs)
SPLUNK_HEC_ENDPOINT="<host:8088>"                 # bare host:port; code appends /services/collector/event
SPLUNK_HEC_TOKEN="<hec token>"
SPLUNK_HEC_INDEX="nwpay_audit"

# ---- ThousandEyes -----------------------------------------------------------
TE_BEARER_TOKEN="<te oauth bearer token>"
TE_ACCOUNT_GROUP_ID="<aid>"
DEMO_BASE_URL="https://<your-demo-host>"          # tests target $DEMO_BASE_URL/api/process — ALWAYS https

# ---- Kubernetes --------------------------------------------------------------
K8S_CONTEXT="<kubectl context>"
K8S_NAMESPACE="natwest"
