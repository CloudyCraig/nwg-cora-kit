yment_name"}}], "dashboard_type": "", "vital_metrics": [{"metric_name": "Replica availability", "unit": "%", "is_key": 1, "matching_entity_fields": ["k8s_deployment_name"], "split_by_fields": ["k8s_deployment_name"], "search": "| union\n    [ mstats latest(_value) AS avail\n        WHERE index=itsi_im_metrics metric_name=k8s.deployment.available\n              \"k8s.namespace.name\"=natwest\n        BY \"k8s.deployment.name\" span=5m\n      | rename \"k8s.deployment.name\" AS k8s_deployment_name\n      | eval src=\"avail\" ]\n    [ mstats latest(_value) AS desired\n        WHERE index=itsi_im_metrics metric_name=k8s.deployment.desired\n              \"k8s.namespace.name\"=natwest\n        BY \"k8s.deployment.name\" span=5m\n      | rename \"k8s.deployment.name\" AS k8s_deployment_name\n      | eval src=\"desired\" ]\n| bin _time span=5m\n| stats max(eval(if(src=\"avail\",   avail,   null()))) AS avail,\n        max(eval(if(src=\"desired\", desired, null()))) AS desired\n        BY _time, k8s_deployment_name\n| where isnotnull(k8s_deployment_name)\n| eval val = if(desired>0, round(avail*100/desired, 1), 100)"}, {"metric_name": "Container restart rate (5m)", "unit": "count", "is_key": 0, "matching_entity_fields": ["k8s_deployment_name"], "split_by_fields": ["k8s_deployment_name"], "search": "| mstats latest(_value) AS rcount\n    WHERE index=itsi_im_metrics metric_name=k8s.container.restarts\n          \"k8s.namespace.name\"=natwest\n    BY \"k8s.deployment.name\" span=5m\n| rename \"k8s.deployment.name\" AS k8s_deployment_name\n| streamstats current=t window=1 range(rcount) AS val by k8s_deployment_name\n| eval val = coalesce(val, 0)"}], "sec_grp": "default_itsi_security_group", "mod_source": "unknown", "mod_timestamp": "2026-08-04T12:02:37.603903+00:00", "identifying_name": "kubernetes deployment (natwest)", "show_navigation_in_service_analyzer": false, "show_dashboards_in_service_analyzer": false, "_version": "5.0.0", "_user": "nobody", "_key": "nwpay_et_k8s_deploy