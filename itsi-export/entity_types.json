age_completion\n| rename \"metric_name:dns.lookup.availability\"           AS dns_avail\n| rename \"metric_name:web.transaction.completion\"        AS tx_completion\n| rename \"thousandeyes.test.name\"                        AS te_test_name\n| eval val = coalesce(http_avail, page_completion, dns_avail, tx_completion*100)\n| where isnotnull(val) AND isnotnull(te_test_name)\n| bin _time span=5m\n| stats avg(val) AS val by _time, te_test_name"}, {"metric_name": "Response time", "unit": "ms", "is_key": 0, "matching_entity_fields": ["te_test_name"], "split_by_fields": ["te_test_name"], "search": "search index=thousandeyes sourcetype=\"cisco:thousandeyes:path-vis\"\n| rename \"metric_name:http.client.request.duration\" AS http_dur_s\n| rename \"metric_name:web.page_load.duration\"       AS page_load_s\n| rename \"thousandeyes.test.name\"                   AS te_test_name\n| eval val = coalesce(http_dur_s * 1000, page_load_s * 1000)\n| where isnotnull(val) AND isnotnull(te_test_name)\n| bin _time span=5m\n| stats avg(val) AS val by _time, te_test_name"}], "sec_grp": "default_itsi_security_group", "show_navigation_in_service_analyzer": true, "mod_source": "unknown", "mod_timestamp": "2026-06-20T10:15:12.048772+00:00", "_version": "4.21.2", "identifying_name": "thousandeyes", "show_dashboards_in_service_analyzer": false, "_user": "nobody", "_key": "nwpay_et_thousandeyes"}, {"title": "pmnts-microservice", "object_type": "entity_type", "description": "Payments L3 microservice. Click-through to Splunk Observability Cloud APM Troubleshooting.", "dashboard_drilldowns": [{"id": "so_apm_troubleshooting", "title": "Splunk Observability - APM Troubleshooting", "dashboard_type": "navigation_link", "base_url": "https://app.eu2.signalfx.com/#/apm/troubleshooting?endTime=Now&filters=%7B%22traceFilter%22:%7B%22tags%22:%5B%5D%7D%7D&startTime=-15m", "params": {"static_params": {}, "alias_param_map": []}}], "data_drilldowns": [], "vital_metrics": [], "dashboard_type": "", "show_navigation_in